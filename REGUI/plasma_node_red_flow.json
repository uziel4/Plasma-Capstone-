  {
    "id": "cmd_action",
    "type": "function",
    "z": "tab_plasma",
    "name": "Build action command",
    "func": "msg.topic = 'plasma/cmd';\nmsg.payload = { action: msg.payload };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
