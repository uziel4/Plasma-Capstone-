        "split_state"
      ]
    ]
  },
  {
    "id": "split_state",
    "type": "function",
    "z": "tab_plasma",
    "name": "Split state to widgets",
    "func": "const s = msg.payload || {};\nreturn [\n  {payload: s.pressureTorr, topic:'Pressure Torr'},\n  {payload: s.pressureTorr, topic:'Pressure Chart'},\n  {payload: s.progress || 0, topic:'Progress'},\n  {payload: s.status || 'UNKNOWN'},\n  {payload: s.mode || 'MANUAL'},\n  {payload: s.voltage || 0},\n  {payload: s.timer || '00:00:00'},\n  {payload: s.roughingActive ? 'ON' : 'OFF'},\n  {payload: s.massFlowActive ? 'ON' : 'OFF'},\n  {payload: s.hvActive ? 'HV ON' : 'HV OFF'},\n  {payload: s.relaySimulated ? 'Simulation' : 'Hardware'}\n];",
    "outputs": 11,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 80,
    "wires": [
      [
        "g_pressure"
      ],
      [
        "c_pressure"
      ],
      [
        "g_progress"
      ],
      [
        "t_status"
      ],
      [
        "t_mode"
      ],
      [
        "t_voltage"
      ],
      [
        "t_timer"
      ],
      [
        "t_roughing"
      ],
      [
        "t_mass_flow"
      ],
      [
        "t_hv"
      ],
      [
        "t_relay_mode"
      ]
    ]
  },
