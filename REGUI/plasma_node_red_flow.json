    "type": "mqtt in",
    "z": "tab_plasma",
    "name": "plasma/state",
    "topic": "plasma/state",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 80,
