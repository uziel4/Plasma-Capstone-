  {
    "id": "cmd_value",
    "type": "function",
    "z": "tab_plasma",
    "name": "Build value command",
    "func": "const action = msg.topic;\nconst value = msg.payload;\nmsg.topic = 'plasma/cmd';\nmsg.payload = { action, value };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
