    "head": "",
    "format": "<template><div class=\"plasma-dashboard\"><section id=\"emergency-panel\" style=\"display:flex;align-items:center;gap:12px;padding:8px 12px;background:#fff1f2;color:#711823;border-bottom:2px solid #b91c1c;font:14px sans-serif;\">\n<button id=\"emergency-button\" style=\"flex-shrink:0;background:#b91c1c;color:white;border:0;border-radius:6px;padding:12px 18px;font-weight:bold;cursor:pointer;\">EMERGENCY SHUTDOWN</button>\n<p id=\"emergency-status\" role=\"status\" style=\"margin:0;max-height:54px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;\">Conectando paro de software… Para controlar el equipo, abra el GUI desde main.py.</p>\n</section>\n  <header><strong>Plasma Capstone · Dashboard</strong><div class=\"controls\"><a href=\"#\" data-plasma-link=\"vacuum\" style=\"color:white\">Vacuum Controller</a><span id=\"status\" role=\"status\">Conectando…</span></div></header>\n  <section class=\"progress\" aria-live=\"polite\"><strong>Estado de conexiones</strong><p id=\"condition\">Esperando lecturas reales.</p><details><summary>Diagnosticos</summary><p id=\"result\" style=\"white-space:pre-line;max-height:100px;overflow:auto\"></p></details></section>\n  <main><div class=\"diagram\" id=\"diagram\">\n    <svg viewBox=\"0 0 1600 900\" role=\"img\" aria-label=\"Diagrama del reactor de plasma con lecturas y estados\">\n      <defs>\n        <linearGradient id=\"pipe\" x2=\"0\" y2=\"1\"><stop stop-color=\"#f4f4f4\"/><stop offset=\".35\" stop-color=\"#aaa\"/><stop offset=\".7\" stop-color=\"#454545\"/><stop offset=\"1\" stop-color=\"#858585\"/></linearGradient>\n        <linearGradient id=\"block\" x2=\"0\" y2=\"1\"><stop stop-color=\"#f7f7f7\"/><stop offset=\".5\" stop-color=\"#aaa\"/><stop offset=\"1\" stop-color=\"#555\"/></linearGradient>\n        <linearGradient id=\"dark\" x2=\"0\" y2=\"1\"><stop stop-color=\"#e9e9e9\"/><stop offset=\".27\" stop-color=\"#828282\"/><stop offset=\".65\" stop-color=\"#333\"/><stop offset=\"1\" stop-color=\"#3c3c3c\"/></linearGradient>\n      </defs>\n      \n      <rect class=\"pipe\" x=\"170\" y=\"107\" width=\"286\" height=\"24\"/><rect class=\"pipe\" x=\"373\" y=\"49\" width=\"23\" height=\"141\"/><rect class=\"pipe\" x=\"394\" y=\"49\" width=\"62\" height=\"24\"/><rect class=\"pipe\" x=\"394\" y=\"166\" width=\"62\" height=\"23\"/>\n      <rect class=\"pipe\" x=\"1360\" y=\"107\" width=\"60\" height=\"24\"/>\n      <rect class=\"block\" x=\"70\" y=\"71\" width=\"102\" height=\"95\" rx=\"12\"/><rect class=\"block\" x=\"233\" y=\"71\" width=\"102\" height=\"95\" rx=\"12\"/><rect class=\"block\" x=\"1420\" y=\"71\" width=\"101\" height=\"95\" rx=\"12\"/>\n      \n      <rect class=\"dark\" x=\"215\" y=\"288\" width=\"1140\" height=\"187\"/><rect class=\"block\" x=\"203\" y=\"270\" width=\"24\" height=\"218\"/><rect class=\"block\" x=\"487\" y=\"270\" width=\"24\" height=\"218\"/><rect class=\"block\" x=\"1076\" y=\"270\" width=\"24\" height=\"218\"/><rect class=\"block\" x=\"1343\" y=\"270\" width=\"24\" height=\"218\"/>\n      <rect class=\"dark\" x=\"753\" y=\"107\" width=\"58\" height=\"543\"/><rect class=\"dark\" x=\"620\" y=\"239\" width=\"27\" height=\"279\" rx=\"12\"/><rect class=\"dark\" x=\"925\" y=\"239\" width=\"27\" height=\"279\" rx=\"12\"/>\n      \n      <rect class=\"pipe\" x=\"442\" y=\"473\" width=\"29\" height=\"215\"/><rect class=\"pipe\" x=\"1109\" y=\"473\" width=\"29\" height=\"215\"/>\n      <rect class=\"block\" x=\"314\" y=\"475\" width=\"80\" height=\"45\" rx=\"8\"/><rect class=\"block\" x=\"441\" y=\"496\" width=\"72\" height=\"48\" rx=\"8\"/><rect class=\"block\" x=\"1181\" y=\"475\" width=\"80\" height=\"45\" rx=\"8\"/><rect class=\"block\" x=\"1066\" y=\"496\" width=\"72\" height=\"48\" rx=\"8\"/>\n      <rect class=\"pipe\" x=\"487\" y=\"602\" width=\"196\" height=\"9\"/><rect class=\"pipe\" x=\"675\" y=\"604\" width=\"8\" height=\"153\"/><rect class=\"pipe\" x=\"896\" y=\"602\" width=\"199\" height=\"9\"/><rect class=\"pipe\" x=\"896\" y=\"604\" width=\"8\" height=\"153\"/>\n      <ellipse class=\"dark\" cx=\"354\" cy=\"699\" rx=\"49\" ry=\"101\"/><ellipse class=\"dark\" cx=\"1224\" cy=\"699\" rx=\"49\" ry=\"101\"/>\n      <rect class=\"block\" x=\"314\" y=\"588\" width=\"80\" height=\"32\" rx=\"6\"/><rect class=\"block\" x=\"1184\" y=\"588\" width=\"80\" height=\"32\" rx=\"6\"/>\n      <rect class=\"pipe\" x=\"402\" y=\"686\" width=\"111\" height=\"30\"/><rect class=\"pipe\" x=\"1068\" y=\"686\" width=\"110\" height=\"30\"/>\n      <rect class=\"block\" x=\"476\" y=\"635\" width=\"69\" height=\"49\" rx=\"8\"/><rect class=\"block\" x=\"1035\" y=\"635\" width=\"69\" height=\"49\" rx=\"8\"/>\n      <rect class=\"block\" x=\"316\" y=\"778\" width=\"77\" height=\"32\" rx=\"7\"/><rect class=\"block\" x=\"1186\" y=\"778\" width=\"76\" height=\"32\" rx=\"7\"/>\n      <rect class=\"block\" x=\"620\" y=\"755\" width=\"117\" height=\"72\" rx=\"10\"/><rect class=\"block\" x=\"844\" y=\"755\" width=\"117\" height=\"72\" rx=\"10\"/>\n      \n      <g class=\"caption\">\n        <text x=\"121\" y=\"185\">Water Chiller</text><text x=\"283\" y=\"185\">Booster Pump</text><text x=\"516\" y=\"30\">Water Temp</text><text x=\"516\" y=\"141\">Water Pressure</text>\n        <text x=\"691\" y=\"40\">Medium Vacuum</text><text x=\"878\" y=\"41\">High Vacuum</text><text x=\"1300\" y=\"87\">Air Pressure</text><text x=\"1471\" y=\"185\">Air Compressor</text>\n        <text x=\"633\" y=\"213\">Field Coil</text><text x=\"633\" y=\"234\">A</text><text x=\"938\" y=\"213\">Field Coil</text><text x=\"938\" y=\"234\">B</text>\n        <text x=\"259\" y=\"502\">Gate Valve</text><text x=\"259\" y=\"523\">A</text><text x=\"1325\" y=\"502\">Gate Valve</text><text x=\"1325\" y=\"523\">B</text>\n        <text x=\"233\" y=\"563\">Cool Trap</text><text x=\"233\" y=\"585\">A</text><text x=\"1344\" y=\"563\">Cool Trap</text><text x=\"1344\" y=\"585\">B</text>\n        <text x=\"576\" y=\"547\">Chamber Valve</text><text x=\"576\" y=\"568\">A</text><text x=\"1000\" y=\"547\">Chamber Valve</text><text x=\"1000\" y=\"568\">B</text>\n        <text x=\"581\" y=\"703\">Diffuse Valve</text><text x=\"581\" y=\"725\">A</text><text x=\"1003\" y=\"703\">Diffuse Valve</text><text x=\"1003\" y=\"725\">B</text>\n        <text x=\"354\" y=\"830\">Diffusion Pump A</text><text x=\"1224\" y=\"830\">Diffusion Pump B</text><text x=\"678\" y=\"850\">Mechanical Pump A</text><text x=\"901\" y=\"850\">Mechanical Pump B</text>\n        <text x=\"470\" y=\"793\">Diff Pump A</text><text x=\"470\" y=\"815\">Temp</text><text x=\"1114\" y=\"793\">Diff Pump B</text><text x=\"1114\" y=\"815\">Temp</text>\n      </g>\n      <g class=\"caption light\"><text x=\"564\" y=\"350\">Coil A Temp</text><text x=\"1014\" y=\"350\">Coil B Temp</text><text x=\"354\" y=\"606\">Trap A Temp</text><text x=\"1223\" y=\"606\">Trap B Temp</text></g>\n    </svg>\n    <div class=\"readout\" data-reading=\"water_temp\" style=\"left:454px;top:33px\" role=\"img\" aria-label=\"Espacio para Water Temp\"><span class=\"value\">—</span><span class=\"unit\">°C</span></div>\n    <div class=\"readout\" data-reading=\"water_pressure\" style=\"left:454px;top:146px\" role=\"img\" aria-label=\"Espacio para Water Pressure\"><span class=\"value\">—</span><span class=\"unit\">bar</span></div>\n    <div class=\"readout\" data-reading=\"medium_vacuum\" style=\"left:630px;top:45px\" role=\"img\" aria-label=\"Espacio para Medium Vacuum\"><span class=\"value\">—</span><span class=\"unit\">mbar</span></div>\n    <div class=\"readout\" data-reading=\"high_vacuum\" style=\"left:817px;top:46px\" role=\"img\" aria-label=\"Espacio para High Vacuum\"><span class=\"value\">—</span><span class=\"unit\">mbar</span></div>\n    <div class=\"readout\" data-reading=\"air_pressure\" style=\"left:1240px;top:92px\" role=\"img\" aria-label=\"Espacio para Air Pressure\"><span class=\"value\">—</span><span class=\"unit\">bar</span></div>\n    <div class=\"readout coil-readout\" data-reading=\"coil_a_temp\" style=\"left:511px;top:365px\" role=\"img\" aria-label=\"Espacio para Coil A Temp\"><span class=\"value\">—</span><span class=\"unit\">°C</span></div>\n    <div class=\"readout coil-readout\" data-reading=\"coil_b_temp\" style=\"left:961px;top:365px\" role=\"img\" aria-label=\"Espacio para Coil B Temp\"><span class=\"value\">—</span><span class=\"unit\">°C</span></div>\n    <div class=\"readout\" data-reading=\"trap_a_temp\" style=\"left:292px;top:528px\" role=\"img\" aria-label=\"Espacio para Trap A Temp\"><span class=\"value\">—</span><span class=\"unit\">°C</span></div>\n    <div class=\"readout\" data-reading=\"trap_b_temp\" style=\"left:1161px;top:528px\" role=\"img\" aria-label=\"Espacio para Trap B Temp\"><span class=\"value\">—</span><span class=\"unit\">°C</span></div>\n    <div class=\"readout\" data-reading=\"diff_pump_a_temp\" style=\"left:407px;top:720px\" role=\"img\" aria-label=\"Espacio para Diff Pump A Temp\"><span class=\"value\">—</span><span class=\"unit\">°C</span></div>\n    <div class=\"readout\" data-reading=\"diff_pump_b_temp\" style=\"left:1052px;top:720px\" role=\"img\" aria-label=\"Espacio para Diff Pump B Temp\"><span class=\"value\">—</span><span class=\"unit\">°C</span></div>\n    <div class=\"state unknown\" style=\"left:69px;top:70px;width:104px;height:97px\" aria-label=\"Water Chiller\"></div>\n    <div class=\"state unknown\" style=\"left:232px;top:70px;width:104px;height:97px\" aria-label=\"Booster Pump\"></div>\n    <div class=\"state unknown\" style=\"left:1419px;top:70px;width:103px;height:97px\" aria-label=\"Air Compressor\"></div>\n    <div class=\"state coil-state unknown\" style=\"left:619px;top:238px;width:29px;height:281px\" aria-label=\"Field Coil A\"></div>\n    <div class=\"state coil-state unknown\" style=\"left:924px;top:238px;width:29px;height:281px\" aria-label=\"Field Coil B\"></div>\n    <div class=\"state unknown\" style=\"left:312px;top:474px;width:83px;height:47px\" aria-label=\"Gate Valve A\"></div>\n    <div class=\"state unknown\" style=\"left:439px;top:494px;width:76px;height:52px\" aria-label=\"Chamber Valve A\"></div>\n    <div class=\"state unknown\" style=\"left:1180px;top:474px;width:83px;height:47px\" aria-label=\"Gate Valve B\"></div>\n    <div class=\"state unknown\" style=\"left:1064px;top:494px;width:76px;height:52px\" aria-label=\"Chamber Valve B\"></div>\n    <div class=\"state unknown\" style=\"left:285px;top:523px;width:134px;height:67px\" aria-label=\"Cool Trap A\"></div>\n    <div class=\"state unknown\" style=\"left:1154px;top:523px;width:134px;height:67px\" aria-label=\"Cool Trap B\"></div>\n    <div class=\"state unknown\" style=\"left:475px;top:634px;width:72px;height:52px\" aria-label=\"Diffuse Valve A\"></div>\n    <div class=\"state unknown\" style=\"left:1033px;top:634px;width:72px;height:52px\" aria-label=\"Diffuse Valve B\"></div>\n    <div class=\"state unknown\" style=\"left:314px;top:777px;width:80px;height:35px\" aria-label=\"Diffusion Pump A\"></div>\n    <div class=\"state unknown\" style=\"left:1184px;top:777px;width:80px;height:35px\" aria-label=\"Diffusion Pump B\"></div>\n    <div class=\"state unknown\" style=\"left:619px;top:754px;width:120px;height:75px\" aria-label=\"Mechanical Pump A\"></div>\n    <div class=\"state unknown\" style=\"left:842px;top:754px;width:120px;height:75px\" aria-label=\"Mechanical Pump B\"></div>\n  </div></main>\n  <p class=\"help\">Monitor de hardware · Presiones en bar, vacío en mbar y temperaturas en °C. Verde: rele energizado; rojo: desenergizado; gris discontinuo: estado desconocido o sin asignacion. Water Temp usa un transmisor de 4-20 mA para 0-100 °C. Field Coil A/B: verde cuando la temperatura sube; rojo cuando esta estable o baja; gris mientras falta comparar lecturas. Indica tendencia termica, no alimentacion electrica.</p></div></template>\n<script>\nexport default {\n  mounted() {\n    const root = this.$el, timers = [], listeners = [];\n    this.$plasmaCleanup = () => { timers.forEach(t => { clearTimeout(t); clearInterval(t); }); listeners.forEach(a => window.removeEventListener(...a)); };\n    const links = {\"vacuum\": [1880, \"/dashboard/main\"], \"dashboard\": [1881, \"/dashboard/main\"]};\n    root.querySelectorAll('[data-plasma-link]').forEach(a => {\n      const [port, path] = links[a.dataset.plasmaLink];\n      a.href = port ? `${location.protocol}//${location.hostname}:${port}${path}` : path;\n    });\n    // Los scripts originales buscan elementos con document.*; aquí solo ven esta pantalla.\n    const document = new Proxy(window.document, {\n      get(target, key) {\n        if (key === 'querySelector') return s => root.querySelector(s);\n        if (key === 'querySelectorAll') return s => root.querySelectorAll(s);\n        if (key === 'getElementById') return id => root.querySelector('#' + CSS.escape(id));\n        const value = Reflect.get(target, key);\n        return typeof value === 'function' ? value.bind(target) : value;\n      }\n    });\n    const setTimeout = (f, ms) => { const t = window.setTimeout(f, ms); timers.push(t); return t; };\n    const setInterval = (f, ms) => { const t = window.setInterval(f, ms); timers.push(t); return t; };\n    const addEventListener = (...a) => { window.addEventListener(...a); listeners.push(a); };\n\n    const diagram = document.querySelector('#diagram');\n    function resize() {\n      const main = document.querySelector('main');\n      const headerHeight = document.querySelector('header').getBoundingClientRect().height;\n      const progressHeight = document.querySelector('.progress').getBoundingClientRect().height;\n      const helpHeight = document.querySelector('.help').getBoundingClientRect().height;\n      const viewportHeight = window.visualViewport?.height || window.innerHeight;\n      const availableHeight = Math.max(0, viewportHeight - document.getElementById('emergency-panel').getBoundingClientRect().height - headerHeight - progressHeight - helpHeight - 28);\n      const scale = innerWidth <= 700 ? 0.65 : Math.min(main.clientWidth / 1600, availableHeight / 900);\n      diagram.style.setProperty('--scale', scale);\n      main.style.height = `${900 * scale}px`;\n    }\n    addEventListener('resize', resize);\n    window.visualViewport?.addEventListener('resize', resize);\n    const layoutObserver = new ResizeObserver(resize);\n    ['header', '.progress', '.help', '#emergency-panel'].forEach(selector => layoutObserver.observe(document.querySelector(selector)));\n    resize();\n\n  \n(() => {\n  const thermal = {coil_a_temp:'Field Magnet A', coil_b_temp:'Field Magnet B', trap_a_temp:'Cool Trap A', trap_b_temp:'Cool Trap B', diff_pump_a_temp:'Diffusion Pump A', diff_pump_b_temp:'Diffusion Pump B'};\n  const analogKeys = ['water_temp','water_pressure','air_pressure','medium_vacuum','high_vacuum'];\n  const states = [...document.querySelectorAll('.state')];\n  states.forEach(el => { el.dataset.equipment = el.getAttribute('aria-label'); });\n  const diagnostics = {};\n  const coilPrevious = {};\n  function coilTrend(name, value, timestamp) {\n    const equipment = name === 'Field Magnet A' ? 'Field Coil A' : 'Field Coil B';\n    const el = states.find(item => item.dataset.equipment === equipment);\n    if (!el) return;\n    const previous = coilPrevious[name];\n    if (Number.isFinite(value) && previous && timestamp === previous.timestamp) return;\n    const valid = Number.isFinite(value) && Number.isFinite(timestamp);\n    // Compare the same 0.1 °C resolution displayed on the dashboard.\n    const current = valid ? Math.round(value * 10) : null;\n    const comparable = valid && previous && timestamp > previous.timestamp && timestamp - previous.timestamp <= 15;\n    const rising = comparable && current > previous.value;\n    const label = !valid ? 'Sin lectura' : !comparable ? 'Esperando segunda lectura' : rising ? 'Temperatura subiendo' : 'Temperatura estable o bajando';\n    el.classList.toggle('unknown', !comparable);\n    el.classList.toggle('on', Boolean(rising));\n    el.title = `${equipment}: ${label}. Tendencia termica; no confirma alimentacion electrica.`;\n    el.setAttribute('aria-label', el.title);\n    if (valid) coilPrevious[name] = {value: current, timestamp};\n    else delete coilPrevious[name];\n  }\n  function report(group, errors) {\n    diagnostics[group] = errors;\n    const all = Object.entries(diagnostics).flatMap(([key, messages]) => messages.map(m => `${key}: ${m}`));\n    const alarm = all.find(m => m.includes('ALARMA High room temperature'));\n    document.querySelector('#status').textContent = alarm ? 'ALARMA: HIGH ROOM TEMPERATURE' : all.length ? 'Atencion: lecturas o estados pendientes' : 'Monitor conectado';\n    document.querySelector('#condition').textContent = Object.entries(diagnostics).map(([k,v]) => `${k}: ${v.length ? 'revisar diagnosticos' : 'conectado'}`).join(' | ');\n    document.querySelector('#result').textContent = all.length ? all.join('\\n') : 'Sin errores de comunicacion. Field Coil A/B indican tendencia de temperatura.';\n  }\n  function reading(key, value, unit, detail='', warning=false) {\n    const el = document.querySelector(`[data-reading=\"${key}\"]`);\n    el.querySelector('.value').textContent = value;\n    el.querySelector('.unit').textContent = unit;\n    el.classList.toggle('warning', warning);\n    el.title = detail;\n    el.setAttribute('aria-label', `${key.replaceAll('_',' ')}: ${value} ${unit}. ${detail}`);\n  }\n  // Vencida si la marca de tiempo de main.py deja de avanzar; no se compara con el reloj de\n  // este navegador (por SSH desde otra PC el reloj del Pi puede no coincidir).\n  const stamps = {};\n  async function poll(group, url, render, clear) {\n    try {\n      const response = await fetch(url,{signal:AbortSignal.timeout(10000)});\n      const data = await response.json();\n      if (!response.ok) throw Error(data.error || `HTTP ${response.status}`);\n      if (url !== '/api/relays') {\n        if (!Number.isFinite(data.timestamp)) throw Error('Lectura sin fecha');\n        if (stamps[url]?.value !== data.timestamp) stamps[url] = {value: data.timestamp, at: Date.now()};\n        if (Date.now() - stamps[url].at > 15000) throw Error('Lectura vencida: main.py no actualiza');\n      }\n      report(group, render(data));\n    } catch (error) {\n      clear(); report(group,[`[DASH_CONNECTION] ${error.message}. Revise main.py, la URL y logs/control.log.`]);\n    } finally { setTimeout(() => poll(group,url,render,clear),1500); }\n  }\n  function clearRelays() {\n    states.filter(el => !el.dataset.equipment.startsWith('Field Coil')).forEach(el => {el.classList.remove('on');el.classList.add('unknown');el.title='Estado no confirmado';el.setAttribute('aria-label',`${el.dataset.equipment}: desconocido`);});\n  }\n  poll('Reles','/api/relays',data => {\n    if (!data.relays) throw Error('Respuesta de reles invalida');\n    const errors=[];\n    states.forEach(el => {\n      const name=el.dataset.equipment, state=data.relays[name];\n      if (name.startsWith('Field Coil')) return;\n      const assigned = !name.startsWith('Field Coil');\n      const known = assigned && state?.configured && typeof state.on==='boolean';\n      el.classList.toggle('unknown',!known);el.classList.toggle('on',known && state.on);\n      const label=known ? (state.on?'ON':'OFF') : assigned?'desconocido':'control no asignado';\n      el.title=`${name}: ${label}`;el.setAttribute('aria-label',el.title);\n      if(assigned && !known) errors.push(`${name}: estado no confirmado`);\n    });\n    return errors;\n  },clearRelays);\n  poll('Temperaturas','/api/temperatures',data => {\n    const errors=[];\n    for(const [key,name] of Object.entries(thermal)) {\n      const entry=data.temperatures?.[name];\n      const valid=entry && !entry.error && Number.isFinite(entry.celsius);\n      const detail=entry?.error?.error || (valid?`THERMOplate 2, canal ${entry.channel}`:'Sin lectura');\n      reading(key,valid?entry.celsius.toFixed(1):'—','°C',detail);\n      if (name.startsWith('Field Magnet')) coilTrend(name, valid ? entry.celsius : null, data.timestamp);\n      if(!valid) errors.push(`${name}: ${detail}`);\n    }\n    const alarm=data.room_alarm, room=data.temperatures?.Room;\n    if(alarm?.active) errors.unshift(`ALARMA High room temperature: Room ${Number.isFinite(alarm.celsius)?alarm.celsius.toFixed(1):'—'} °C (activa > ${alarm.limit_c} °C; se desactiva a <= ${alarm.clear_c} °C)`);\n    else if(!room || room.error || !Number.isFinite(room.celsius)) errors.push(`Room: ${room?.error?.error || 'Sin lectura'}`);\n    return errors;\n  },() => {\n    Object.keys(thermal).forEach(k=>reading(k,'—','°C','Sin conexion'));\n    ['Field Magnet A','Field Magnet B'].forEach(name => coilTrend(name,null,null));\n  });\n  poll('ADC','/api/pressures',data => {\n    const errors=[];\n    for(const [key,name] of [['water_pressure','Water'],['air_pressure','Air']]) {\n      const e=data.pressures?.[name], warning=e?.error?.code==='PRESS_RANGE';\n      const valid=e && Number.isFinite(e.psi) && Number.isFinite(e.ma) && (!e.error || warning);\n      const detail=e?.error?.error || (valid?`${e.channel}: ${e.ma.toFixed(3)} mA`:'Sin lectura');\n      reading(key,valid?(e.psi / 14.5037738).toFixed(2):'—','bar',detail,warning);\n      if(!valid || warning)errors.push(`${name}: ${detail}`);\n    }\n    const water=data.water_temperature;\n    const valid=water && !water.error && Number.isFinite(water.celsius);\n    reading('water_temp',valid?water.celsius.toFixed(2):'—','°C',water?.error?.error || 'I0: °C = (mA - 4) × 6.25');\n    if(!valid)errors.push(water?.error?.error || 'Sin corriente de temperatura Water');\n    for(const [key,name] of [['medium_vacuum','Medium Vacuum'],['high_vacuum','High Vacuum']]) {\n      const e=data.vacuum?.[name],ok=e && !e.error && Number.isFinite(e.torr) && e.torr>0;\n      const detail=e?.error?.error || (ok?`${e.channel}: ${e.volts} V`:'Sin lectura');\n      reading(key,ok?(e.torr * 1.333223874).toExponential(2):'—','mbar',detail);\n      if(!ok)errors.push(`${name}: ${detail}`);\n    }\n    return errors;\n  },() => analogKeys.forEach(k=>reading(k,'—',k==='water_temp'?'°C':k.includes('vacuum')?'mbar':'bar','Sin conexion')));\n})();\n\n(() => {\n  const button = document.getElementById('emergency-button');\n  const status = document.getElementById('emergency-status');\n  let busy = false;\n  async function request(stop) {\n    const response = await fetch('/api/emergency', {method: stop ? 'POST' : 'GET', signal: AbortSignal.timeout(15000),\n      ...(stop ? {headers: {'Content-Type': 'application/json'}, body: '{}'} : {})});\n    if (!response.ok) throw Error(`HTTP ${response.status}`);\n    const data = await response.json();\n    if (typeof data.active !== 'boolean') throw Error('Respuesta invalida');\n    if (data.active) {\n      const result = data.result;\n      status.textContent = result?.confirmed\n        ? 'PARO ACTIVADO. Relés OFF y consigna cero confirmados en las placas. Mandos bloqueados hasta reiniciar main.py.'\n        : `PARO ACTIVADO: hay salidas sin confirmar. Mandos bloqueados.\\n${Object.entries(result?.errors || {}).map(([k,v])=>`${k}: ${v}`).join('\\n')}`;\n      button.textContent = 'REINTENTAR APAGADO';\n    }\n  }\n  button.addEventListener('click', async () => {\n    if (busy) return;\n    busy = true; button.disabled = true;\n    status.textContent = 'Solicitando apagado…';\n    try { await request(true); }\n    catch { status.textContent = 'NO SE PUDO CONFIRMAR EL PARO. Compruebe el equipo y use el paro físico. La orden pudo llegar al servidor.'; }\n    finally { busy = false; button.disabled = false; }\n  });\n  async function poll() {\n    if (!busy) { try { await request(false); } catch { if (button.textContent === 'EMERGENCY SHUTDOWN') status.textContent = 'Sin conexión con el paro. Abra main.py y use su dirección; Live Server no controla el hardware.'; } }\n    setTimeout(poll, 2000);\n  }\n  poll();\n})();\n\n  },\n  unmounted() { this.$plasmaCleanup?.(); }\n}\n</script>\n<style>\n/* Devuelve a los controles el estilo del navegador que el reset de Vuetify elimina. */\n.plasma-dashboard :where(button,input,textarea,select,h1,h2,p,ol,ul,li,details,summary,a,pre) { all: revert; }\n.plasma-dashboard [hidden] { display: none !important; }\n.plasma-dashboard{ font-family: Arial, Helvetica, sans-serif; color: #1e2731; background: #e9edf1; }\n.plasma-dashboard, .plasma-dashboard *{ box-sizing: border-box; }\n.plasma-dashboard{ margin: 0; min-height: 100vh; }\n.plasma-dashboard header{ display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .6rem 1.2rem; padding: .65rem clamp(1rem, 2vw, 2rem); background: linear-gradient(#29323b, #232c35); color: white; }\n.plasma-dashboard header strong{ font-size: 1.05rem; }\n.plasma-dashboard .controls{ display: flex; align-items: center; flex-wrap: wrap; gap: .55rem; }\n.plasma-dashboard .controls button{ font: inherit; font-size: .9rem; font-weight: bold; padding: .58rem 1rem; border: 1px solid #0002; border-radius: 7px; cursor: pointer; }\n.plasma-dashboard .controls button:not(:disabled):hover{ filter: brightness(1.08); }\n.plasma-dashboard .controls button:focus-visible{ outline: 3px solid #66a9ff; outline-offset: 2px; }\n.plasma-dashboard .controls button:disabled{ opacity: .48; cursor: default; }\n.plasma-dashboard #start{ background: #159653; color: #fff; }\n.plasma-dashboard #confirm{ background: #d3ac40; color: #252a2e; }\n.plasma-dashboard #reset{ background: #f5f6f7; color: #1e2731; }\n.plasma-dashboard #status{ display: inline-flex; align-items: center; gap: .55rem; padding-left: .8rem; border-left: 1px solid #7c858c; color: #f2f4f6; font-size: .87rem; }\n.plasma-dashboard #status::before{ content: \"\"; width: 11px; height: 11px; flex: none; border-radius: 50%; background: #aeb2b5; }\n.plasma-dashboard #status.running::before{ background: #2bb772; }\n.plasma-dashboard .progress,.plasma-dashboard .help{ width: calc(100% - 2rem); max-width: 1600px; margin: .55rem auto; background: #fbfcfd; border: 1px solid #bbc8d4; border-radius: 7px; }\n.plasma-dashboard .progress{ padding: .65rem 1rem; }\n.plasma-dashboard .progress strong{ display: block; margin-bottom: .2rem; font-size: 1rem; }\n.plasma-dashboard .progress p{ margin: .1rem 0; font-size: .88rem; }\n.plasma-dashboard #result{ color: #157947; font-weight: bold; }\n.plasma-dashboard #result.fault{ color: #bd262e; }\n.plasma-dashboard main{ width: 100%; margin: auto; overflow: hidden; display: flex; justify-content: center; align-items: flex-start; }\n.plasma-dashboard .diagram{ position: relative; width: 1600px; height: 900px; flex: none; zoom: var(--scale, 1); background: radial-gradient(ellipse at center, #f8fafc 0%, #e8edf1 78%, #dce4ea 100%); }\n.plasma-dashboard svg{ display: block; width: 100%; height: 100%; }\n.plasma-dashboard .readout{ position: absolute; width: 122px; height: 57px; padding: 0 10px; border: 1.5px solid #697784; border-radius: 12px; background: #fff; color: #16212b; font-size: 17px; font-weight: bold; font-variant-numeric: tabular-nums; display: flex; align-items: center; justify-content: space-between; gap: 3px; box-shadow: 0 3px 8px #202a321b; }\n.plasma-dashboard .readout .value{ min-width: 0; font-size: 16px; letter-spacing: -.04em; white-space: nowrap; }\n.plasma-dashboard .readout .unit{ flex: none; color: #586674; font-size: 12px; font-weight: 600; }\n.plasma-dashboard .readout.coil-readout{ width: 106px; }\n.plasma-dashboard .state{ position: absolute; padding: 0; border: 3px solid #f20d13; border-radius: 10px; background: transparent; pointer-events: none; }\n.plasma-dashboard .state.coil-state{ border-radius: 14px; }\n.plasma-dashboard .state.on{ border-color: #17a65b; }\n.plasma-dashboard .caption{ font-size: 17px; font-weight: bold; fill: #1d2630; text-anchor: middle; }\n.plasma-dashboard .caption.light{ fill: white; paint-order: stroke; stroke: #555; stroke-width: 2px; stroke-linejoin: round; }\n.plasma-dashboard .pipe{ fill: url(#pipe); stroke: #2b3238; stroke-width: 1.4; }\n.plasma-dashboard .block{ fill: url(#block); stroke: #2b3238; stroke-width: 1.4; }\n.plasma-dashboard .dark{ fill: url(#dark); stroke: #20262b; stroke-width: 1.3; }\n.plasma-dashboard .help{ padding: .6rem .8rem; color: #455260; font-size: .78rem; line-height: 1.35; }\n@media (max-width: 700px){.plasma-dashboard header{ justify-content: center; text-align: center; }\n.plasma-dashboard .controls{ justify-content: center; }\n.plasma-dashboard #status{ border-left: 0; padding-left: 0; }}\n.plasma-dashboard .state.unknown{ border-color: #7e8790; border-style: dashed; }\n.plasma-dashboard .readout.warning{ border-color: #c58000; background: #fff3cc; }\n.plasma-dashboard #emergency-panel{ position: sticky; top: 0; z-index: 100; flex-wrap: wrap; }\n.plasma-dashboard #emergency-status{ flex: 1 1 260px; }\n@media (max-width: 700px){.plasma-dashboard main{ overflow-x: auto; justify-content: flex-start; }\n.plasma-dashboard .progress,.plasma-dashboard .help{ width: calc(100% - 16px); }}\n</style>",
